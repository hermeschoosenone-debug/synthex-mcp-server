# Copy to .env and fill in. NEVER commit a real .env — it is gitignored.

# The payer private key for x402 payments (USDC on Base mainnet).
# Read from the environment only: never logged, never written to disk.
# Leave UNSET to use the free `catalogue` tool without spending anything.
SYNTHX_PAYER_PRIVATE_KEY=

# Set to 1 to permit a real on-chain payment. Off by default.
SYNTHX_ALLOW_LIVE_SPEND=

# Optional overrides.
# SYNTHX_BASE_URL=https://x402.synthexforge.com
# SYNTHX_TIMEOUT_MS=30000
